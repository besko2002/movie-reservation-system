# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
# Host port 5434 is the docker-compose mapping (see docker-compose.yml).
DB_URL=jdbc:postgresql://localhost:5434/movie_reservation
DB_USERNAME=movie
DB_PASSWORD=movie

# --- Security / JWT (used from phase 2 on) ---
# JWT_SECRET must be at least 32 bytes (HS256); the app refuses to start otherwise.
JWT_SECRET=change-me-to-a-long-random-base64-secret
# Access token lifetime in milliseconds (3600000 = 1 hour).
JWT_EXPIRATION=3600000

# --- Seeded administrator (created at startup when missing) ---
ADMIN_EMAIL=admin@cinema.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Admin

# --- Stripe (used from phase 7 on) ---
# Both may stay empty: payments are then disabled and the ticket endpoints that need Stripe answer
# 503 Service Unavailable with an ApiError instead of failing with a 500.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# ISO 4217 currency of every Checkout Session and refund.
STRIPE_CURRENCY=usd

# --- Tickets (phase 7) ---
# A paid ticket can only be cancelled (full refund) until this many hours before the showtime.
TICKET_CANCELLATION_CUTOFF_HOURS=2
# How long a buyer has to pay a checkout: this is both the Stripe Checkout Session's expires_at and
# the new expiry of the seat holds the ticket was opened for, so the holds cannot be swept away
# while the payment page is still payable. Stripe only accepts 30..1440 minutes; a value outside
# that range makes the application fail to start.
TICKET_CHECKOUT_MINUTES=30

# --- Application ---
APP_BASE_URL=http://localhost:8080
